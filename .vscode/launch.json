{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI (Uvicorn)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "fast_api_server.main:app",
                "--reload",
                "--port", "5001"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "JWT_SECRET_KEY": "please-change-me",
                "ENC_KEY": "qN0MrQd968LRVNffCVP6EAtQ539gJWZRBYntQKexQhU=",
                "GOOGLE_APPLICATION_CREDENTIALS": "pythonsponge-google-creds.json",
                "DEBUG": "True"
            }
        },
        {
            "name": "Websocket",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/ws_server/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "JWT_SECRET_KEY": "please-change-me",
                "ENC_KEY": "qN0MrQd968LRVNffCVP6EAtQ539gJWZRBYntQKexQhU=",
                "GOOGLE_APPLICATION_CREDENTIALS": "pythonsponge-google-creds.json",
                "DEBUG": "True"
            }
        }
    ]
}