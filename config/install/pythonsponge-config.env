# Server name. E.g. pythonsponge.com, or pythonsponge.myschool.com
# this will be injected into your nginx config
# and will be picked up by CORS checks
SERVER_NAME=

# local linux user's name. Default: pythonsponge
SERVICE_USER=pythonsponge

# authentication method -- how will the students and teachers log in?
# MSAL or GOOGLE
AUTH_PROVIDER=
