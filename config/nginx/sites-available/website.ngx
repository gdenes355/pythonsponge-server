upstream api_server {
        server 127.0.0.1:8000;
}

upstream ws_server {
        server 127.0.0.1:5002;
}

server {
		server_name $SERVER_NAME;
		add_header Access-Control-Allow-Origin "$SERVER_NAME";
		add_header Cross-Origin-Opener-Policy "same-origin";
		add_header Cross-Origin-Embedder-Policy "require-corp";
		listen [::]:443 ssl ipv6only=on;
        listen 443 ssl;
        
		ssl_certificate /home/pythonsponge/deployed/env/fullchain.pem; # from Cloudflare
		ssl_certificate_key /home/pythonsponge/deployed/env/privkey.pem; # from Cloudflare

        client_max_body_size 80m;

        access_log /var/log/nginx/frontend-access.log;
        error_log  /var/log/nginx/frontend-error.log error;

        charset utf-8;
		
		location /api {
			proxy_set_header HOST $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_pass http://api_server;
		}
		
		location /books/ {
			proxy_set_header HOST $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_pass http://api_server;
		}
		
		location /ws/ {
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header Host $host;
			proxy_set_header X-Forwarded-Proto $scheme;

			proxy_pass http://ws_server;

			proxy_http_version 1.1;
			proxy_set_header Upgrade $http_upgrade;
			proxy_set_header Connection "upgrade";
		}
		
		location /books-internal/ {
			internal;
			alias /home/pythonsponge/deployed/server/books/;
		}
		
		location /auth-callback {
            try_files $uri /index.html;
        }

		location  = / {
			if ($query_string !~ "bk\=.*") { 
				# redirect index site to book start page
				return 301 /student/books;
			}
			try_files $uri /index.html ;
		}

		location /teacher/start {
			try_files $uri /index.html;
		}

		location /student/books {
			try_files $uri /index.html;
		}
		
		location /teacher {
            try_files $uri /index.html;
        }

		location /book-editor-frame {
            try_files $uri /index.html;
        }
        
		location / {
            root /home/pythonsponge/deployed/app;
        }
}
